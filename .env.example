# ============================================================
# 环境变量示例（复制为 .env 后按需修改）
# 优先级：环境变量 > config/*.yaml
# 格式：G05_<段名>__<键名>（双下划线分隔层级，全部大写）
# ============================================================

# ---- 服务 ----
# G05_SERVER__HOST=0.0.0.0
# G05_SERVER__PORT=8000

# ---- 应用 ----
# G05_APP__ENV=prod
# G05_APP__DEBUG=false

# ---- 导入 ----
# G05_IMPORT__MAX_ROWS=200000
# G05_IMPORT__CHUNK_SIZE=1000
# G05_IMPORT__ALLOW_UPDATE=false

# ---- 数据库 ----
# G05_DATABASE__DATABASE__PATH=data/db/g05.db
# G05_DATABASE__DATABASE__PRAGMA__BUSY_TIMEOUT=10000

# ---- 血缘 ----
# G05_LINEAGE__MAX_DEPTH=10
# G05_LINEAGE__MAX_NODES=5000

# 注意：环境变量覆盖适合容器化/临时调试。
# 常规配置请改 config/*.yaml —— 集中可查，不会散落在各处。
